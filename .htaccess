# =====================================================================
# LK-TECH (Linksmartech) — version PHP
# À placer à la racine du site (public_html). Rien à modifier.
# =====================================================================

# ---------------------------- Page d'accueil -------------------------------
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si le site est installé dans un sous-dossier, adaptez RewriteBase :
    # RewriteBase /linksmartec/

    # Adresses sans extension
    RewriteRule ^a-propos/?$ a-propos.php [L,QSA]
    RewriteRule ^admin/?$ admin/index.php [L,QSA]

    # API : /api/... → api/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]

    # Sécurité : on n'accède jamais directement aux données ni au code
    RewriteRule ^(app|data|config)/ - [F,L]

    # Version Node.js (facultative, dossier node/) et outils : jamais servis
    RewriteRule ^(node|tools)/ - [F,L]

    # Fichiers cachés (.git, .env, .htaccess…) : jamais servis
    # (.well-known reste accessible pour les certificats HTTPS)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Empêche l'affichage du contenu des dossiers
Options -Indexes

# Fichiers de documentation et de déploiement : inutiles en ligne
<FilesMatch "^(README|DEPLOIEMENT|LISEZ-MOI)\.md$|^(package\.json|render\.yaml|Dockerfile|Procfile|\.env\.example|\.dockerignore|\.gitignore)$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --------------------------- En-têtes de sécurité --------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Les images et le logo changent rarement : on les met en cache 7 jours
    <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

# --------------------------------- Compression -----------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
        application/javascript application/json image/svg+xml
</IfModule>

# --------------------------- Pages d'erreur --------------------------------
ErrorDocument 404 /index.php
