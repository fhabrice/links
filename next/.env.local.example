# =====================================================================
# LK-TECH — Backend Next.js + Supabase
# ---------------------------------------------------------------------
# TOUTES ces variables sont FACULTATIVES : sans elles, le site tourne
# avec un stockage local JSON (dossier next/data/).
# Dès que NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY sont
# présentes, le backend bascule automatiquement sur Supabase.
# =====================================================================

# --- Supabase (Dashboard → Project Settings → API) -------------------
# NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # clé "service_role" (secret !)
# SUPABASE_ANON_KEY=eyJhbGciOi...           # clé "anon" (publique)

# E-mail de l'administrateur créé dans Supabase → Authentication → Users
# SUPABASE_ADMIN_EMAIL=admin@linksmartec.com

# --- Sessions / sécurité ---------------------------------------------
# SESSION_SECRET=une-chaine-aleatoire-longue-pour-les-cookies-locaux
# PORT=3001
