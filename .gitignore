# Dépendances
node_modules/
package-lock.json

# Données locales générées à l'exécution (contenu, messages, images téléversées)
data/*
!data/.gitkeep

# Version PHP : mêmes données, dans php/data et php/uploads
php/data/*
!php/data/.htaccess
php/uploads/*
!php/uploads/.htaccess
php/config/database.php

# Configuration réelle d'une éventuelle base (jamais versionnée)
config/database.json

# Environnement
.env
.env.local

# Divers
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.tmp/
